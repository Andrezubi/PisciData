{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Jwt": {
    "Key": "ReplaceWithASecretKeyOfAtLeast16Chars",
    "Issuer": "PisciData",
    "Audience": "PisciDataUsers",
    "ExpiryMinutes": "60"
  },
  "AI": {
    "Ollama": {
      "BaseUrl": "http://localhost:11434/",
      "Model": "piscidata-ai",
      "MaxToolIterations": 5
    },
    "MCP": {
      "ServerDll": "../PisciDataMCP/bin/Debug/net10.0/win-x64/PisciDataMCP.dll"
    },
    "Whisper": {
      "ModelPath": "models/ggml-base.bin",
      "Language": "es"
    }
  }
}
